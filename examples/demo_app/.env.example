# Example environment variables for modulith demo.
# Copy this file to `.env` and uncomment the block for your desired mode.

# --- Durable transactional outbox (zero-infra SQLite by default) ---
# Persists messages before the API returns. Single-process.
# Comment out all other mode blocks if using this one.
#
# Default (SQLite, zero-infra):
# MODULITH_OUTBOX=postgres
# MODULITH_DB_URL=sqlite+aiosqlite:///./demo.db
#
# Or Postgres (requires docker-compose up -d postgres):
# MODULITH_OUTBOX=postgres
# MODULITH_DB_URL=postgresql+asyncpg://modulith:modulith@localhost:5432/modulith

# --- Cross-process: database broker (zero-infra SQLite) ---
# Distributes work across processes using a database as message bus.
# Requires: python -m modulith workers
# Comment out all other mode blocks if using this one.
#
# MODULITH_TOPOLOGY=processes
# MODULITH_BROKER=database
# MODULITH_BROKER_URL=sqlite+aiosqlite:////absolute/path/to/demo-broker.db
# MODULITH_BROKER_POLL_INTERVAL_MS=100

# --- Cross-process: redis-streams broker ---
# Distributes work across processes using Redis.
# Requires: docker-compose up -d redis
# Requires: python -m modulith workers
# Comment out all other mode blocks if using this one.
#
# MODULITH_TOPOLOGY=processes
# MODULITH_BROKER=redis-streams
# REDIS_URL=redis://localhost:6379
# MODULITH_STREAM_PREFIX=modulith.demo

# --- Optional demo add-ons ---
# Enable OpenTelemetry spans (console exporter, requires modulith[otel]):
# MODULITH_DEMO_OTEL=1

# Enable custom serializer example (storage-only, for learning):
# MODULITH_DEMO_SERIALIZER=custom

# --- CLI package resolution ---
# Already configured in [tool.modulith].package, but can be overridden:
# MODULITH_PACKAGE=shop
